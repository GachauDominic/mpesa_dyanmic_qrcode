
### register an Admin
POST http://localhost:3000/api/auth/register
Content-Type: application/json

# {
#   "email": "gachaudominic@gmail.com",
#   "passwordHash": "*T89z>O35e=7tm",
#   "role": "SUPER_ADMIN",
#   "firstName ": "Dominic",
#   "lastName": "Maina"
# }

### login an admin
# @name Login
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "gachaudominic@gmail.com",
  "password": "*T89z>O35e=7tm"
}

###Extract the Admin token from login response
@token = {{Login.response.body.token}}

### generate a qr-code with Admin
# @name generateQr
POST http://localhost:3000/api/qr/generate
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "merchantId": "d0c1c79f-6717-49ee-be4c-4cf5827a6d68",
  "channelType": "PAYBILL",
  "amount": 50
}

###Extract the id from generate qr code response
@qrId = {{generateQr.response.body.id}}

### get qr-code
GET http://localhost:3000/api/qr/{{qrId}}
Authorization: Bearer {{token}}

### create a merchant (requires the super admin token)
# @name createMerchant
POST http://localhost:3000/api/merchants
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "businessName": "AIRTEL Credit",
  "channelType": "PAYBILL",
  "cpi": "220220"
}

### Extract merchant ID from the response
@merchantId = {{createMerchant.response.body.merchantId}}

### Add a channel to a merchant
POST http://localhost:3000/api/merchants/{{merchantId}}/channels
Content-Type: application/json

{
  "channelType": "",
  "cpi": ""
}

### generate a qr-code with superAdmin
# @name sp_generateQr
POST http://localhost:3000/api/qr/generate
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 66
}

###Extract the superAdmin id from generate qr code response
@superqrId = {{sp_generateQr.response.body.id}}

### get qr-code
GET http://localhost:3000/api/qr/{{superqrId}}
Authorization: Bearer {{superToken}}

