@baseUrl = http://localhost:3000
@seededMerchantId = d0c1c79f-6717-49ee-be4c-4cf5827a6d68

### register an Admin
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "dom@gmail.com",
  "password": "z>O35e=7tm",
  "firstName": "Dom",
  "lastName": "Maina"
}

### Log in as the seeded super admin
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "gachaudominic@gmail.com",
  "password": "*T89z>O35e=7tm"
}

### Extract the token
@token = {{login.response.body.token}}


### Generate a QR using the seeded merchant's default channel
# @name generateQr
POST {{baseUrl}}/api/qr/generate
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "merchantId": "13a5a784-9791-4763-a9ae-a68af0409a7a",
  "amount": 50
}

### Extract the id
@qrId = {{generateQr.response.body.id}}


### Fetch that QR's status
GET {{baseUrl}}/api/qr/{{qrId}}
Authorization: Bearer {{token}}


### View the actual QR image
GET {{baseUrl}}/api/qr/{{qrId}}/image
Authorization: Bearer {{token}}


### Create a new merchant (requires SUPER_ADMIN)
# @name createMerchant
POST {{baseUrl}}/api/merchants
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "businessName": "AIRTEL Credit",
  "channelType": "PAYBILL",
  "cpi": "220220"
}

### Extract the new merchant's id
@merchantId = {{createMerchant.response.body.merchantId}}


### Generate a QR for the new merchant — exactly one PAYBILL channel so far, unambiguous
POST {{baseUrl}}/api/qr/generate
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "merchantId": "{{merchantId}}",
  "channelType": "PAYBILL",
  "amount": 90
}


### Add a SECOND Paybill channel to that same new merchant
# @name addSecondChannel
POST {{baseUrl}}/api/merchants/{{merchantId}}/channels
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "channelType": "PAYBILL",
  "cpi": "921999"
}

### Extract the second channel's id
@secondChannelId = {{addSecondChannel.response.body.id}}


### Now channelType alone is ambiguous (2 PAYBILL channels) — expect a 400
POST {{baseUrl}}/api/qr/generate
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "merchantId": "{{merchantId}}",
  "channelType": "PAYBILL",
  "amount": 66
}


### Disambiguate with channelId instead — this one succeeds
POST {{baseUrl}}/api/qr/generate
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "merchantId": "{{merchantId}}",
  "channelId": "{{secondChannelId}}",
  "amount": 66
}



