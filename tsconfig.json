{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "stableTypeOrdering": true,
    "ignoreDeprecations": "6.0",
  },
  "include": ["src/**/*.ts"],
  "exclude": [ "node_modules",
    "dist",
    "tests",
    "k6",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/**/__mocks__/**"
  ]
}
